{
  "name": "zync-docker-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm test && npm run build",
    "format": "prettier --write src tests scripts *.json *.ts *.html *.md \"docs/**/*.md\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html *.md \"docs/**/*.md\" \".github/workflows/*.yml\""
  },
  "dependencies": {
    "@zync-sh/plugin-ui": "0.1.0-beta.1",
    "lucide-react": "^0.575.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@zync-sh/plugin-sdk": "2.1.0-beta.1",
    "esbuild": "0.28.2",
    "prettier": "^3.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "8.3.1"
  }
}
